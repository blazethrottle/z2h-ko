---
// A 랜딩 (spec 13.1, 목업 v2_landing). 구역 7개: 첫 화면, 끝내면 얻는 것, 이런 분께, 수료까지의 길, 코드를 처음 봐도 따라갈 수 있게, 끝 CTA, 바닥.
// 문구는 src/content/landing.mjs 한 곳(공개 전 승인 항목 D46, "예시 화면" 표시 유지). 단계 수는 video-segments.json 에서 세고,
// 수료까지의 길의 누적 점검 구성은 홈과 같은 출처(content/lectures.yaml)에서 src/lib/landingPath.ts 가 채운다. 전체 시간은 보이지 않는다(2026-11-18 결정).
// 채운 accent 버튼은 첫 화면과 끝 CTA 에 하나씩(한 뷰포트에 1개). 로그인 화면은 없어 보조 버튼은 "학습 홈".
import Base from '../layouts/Base.astro';
import MiniCode from '../components/MiniCode.tsx';
import { LANDING as L } from '../content/landing.mjs';
import { loadSite } from '../lib/pageData';
import { loadTaster } from '../lib/content/taster.mjs';
import { landingPathRows } from '../lib/landingPath';

const site = loadSite();
const taster: any = loadTaster();
const counts: Record<string, number> = site.stepCounts ?? {};
const pathRows = landingPathRows(L.path.rows, { checkpoints: site.checkpoints, stepCounts: counts });
const lectureRows = pathRows.filter((r) => r.lecture_id);
const totalSteps = lectureRows.reduce((a, r) => a + (counts[r.lecture_id ?? ''] ?? 0), 0);
const lead = L.path.lead
  .replace('{lectures}', String(lectureRows.length))
  .replace('{steps}', String(totalSteps))
  .replace('{checks}', String(pathRows.filter((r) => r.checkpoint).length));
const codeStep = taster.steps.find((s: any) => s.step_id === L.hero.code.step_id);
const codeLines = String(codeStep?.code ?? '').split('\n');
const codeRows = L.hero.code.lines
  .map((n: number) => ({ code: (codeLines[n - 1] ?? '').trim(), note: codeStep?.code_line_notes_ko?.[n - 1] ?? '' }))
  .filter((r: any) => r.code);
---
<Base title="소개" tabs={false} bar="landing" wide description={L.hero.promise}>
  <p class="sample-band" data-testid="sample-badge">
    <span class="pill">{L.sample.label}</span>
    <span>{L.sample.note}</span>
  </p>

  <section class="lp-hero" aria-labelledby="lp-hero-h" data-testid="landing-hero">
    <div class="stack">
      <h1 id="lp-hero-h">{L.hero.promise}</h1>
      <p class="muted">{L.hero.lead}</p>
      <div class="lp-cta">
        <a class="btn primary" href="/taste/" data-testid="cta-taste">{L.hero.primary}</a>
        <a class="btn" href="/home/" data-testid="cta-home">{L.hero.secondary}</a>
      </div>
      <p class="cap">{L.hero.caption}</p>
      <p class="cap">{L.hero.secondaryNote}</p>
    </div>
    {codeRows.length > 0 && <MiniCode rows={codeRows} label={L.hero.code.label} />}
  </section>

  <section class="lp-sec" aria-labelledby="lp-gains-h" data-testid="landing-gains">
    <h2 id="lp-gains-h" class="t2">{L.gains.title}</h2>
    <p class="small muted lp-lead">{L.gains.lead}</p>
    <div class="lp-grid lp-badges">
      {L.gains.badges.map((b: any) => (
        <div class="card">
          <div class="lp-badge-head">
            <span class="lp-mark" aria-hidden="true">{b.no}</span>
            <div>
              <h3 class="label">{b.name}</h3>
              <p class="cap">{b.rule}</p>
            </div>
          </div>
          <p class="cap">{L.gains.outputsLabel}</p>
          <ul>{b.outputs.map((o: string) => <li>{o}</li>)}</ul>
        </div>
      ))}
    </div>
    <p class="cap" style="margin-top:var(--space-4)">{L.gains.note}</p>
  </section>

  <section class="lp-sec" aria-labelledby="lp-aud-h" data-testid="landing-audience">
    <h2 id="lp-aud-h" class="t2">{L.audience.title}</h2>
    <div class="lp-grid lp-aud">
      {L.audience.items.map((a: any) => (
        <div class="card">
          <h3 class="label">{a.name}</h3>
          <p class="msg">{a.message}</p>
          <dl>
            <dt>{L.audience.pathLabel}</dt>
            <dd>{a.path}</dd>
          </dl>
        </div>
      ))}
    </div>
    <p class="cap" style="margin-top:var(--space-3)">{L.audience.note}</p>
  </section>

  <section class="lp-sec" aria-labelledby="lp-path-h" data-testid="landing-path">
    <h2 id="lp-path-h" class="t2">{L.path.title}</h2>
    <p class="small muted lp-lead num" data-testid="landing-path-lead">{lead}</p>
    <ol class="lp-path">
      {pathRows.map((r) => (
        <li class={r.checkpoint ? 'cp' : ''} data-lecture={r.lecture_id ?? undefined} data-checkpoint={r.checkpoint_id ?? undefined}>
          <span class="dot">{r.mark}</span>
          <div>
            <span class="t">{r.name}</span> {r.meta && <span class="m">· {r.meta}</span>}
            <br />
            <span class="small">{r.promise}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="lp-sec" aria-labelledby="lp-sup-h" data-testid="landing-support">
    <h2 id="lp-sup-h" class="t2">{L.support.title}</h2>
    <div class="lp-grid lp-ev">
      {L.support.cards.map((c: any) => (
        <div class="card">
          <h3 class="label">{c.title}</h3>
          <p class="small muted">{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="lp-sec stack" aria-labelledby="lp-end-h" data-testid="landing-end">
    <h2 id="lp-end-h" class="t2">{L.end.title}</h2>
    <p class="muted">{L.end.body}</p>
    <div class="lp-cta">
      <a class="btn primary" href="/taste/" data-testid="cta-taste-end">{L.hero.primary}</a>
      <a class="btn" href="/home/">{L.hero.secondary}</a>
    </div>
  </section>

  <footer class="lp-foot stack-sm" data-testid="landing-footer">
    <p class="cap">{L.footer.text}</p>
    <p class="cap">{L.footer.legal}</p>
  </footer>
</Base>
