---
// 단계 화면 /lectures/L01/S04/ (step_id 뒷부분은 문자열 그대로, 예 S14b)
import Base from '../../../layouts/Base.astro';
import StepApp from '../../../components/StepApp.tsx';
import { codeCredit, fileNameOf, lectureLabel, loadSite } from '../../../lib/pageData';
import CodeCredit from '../../../components/CodeCredit.astro';
import { loadBasics } from '../../../lib/content/basics.mjs';

export function getStaticPaths() {
  const site = loadSite();
  return Object.entries(site.details).flatMap(([lid, d]: [string, any]) =>
    d.steps.map((s: any) => ({ params: { lecture: lid, step: s.slug }, props: { lid, stepId: s.step_id } })),
  );
}
const { lid, stepId } = Astro.props as { lid: string; stepId: string };
const d: any = loadSite().details[lid];
const step = d.steps.find((s: any) => s.step_id === stepId);
const label = lectureLabel(lid, d.lecture.title_ko);
const questions = step.question_ids.map((q: string) => d.questions.find((x: any) => x.question_id === q)).filter(Boolean);
const steps = d.steps.map((s: any) => ({ step_id: s.step_id, slug: s.slug, order: s.order, title_ko: s.title_ko, video_segments: s.video_segments }));
const nb = d.lecture.notebook?.student ? fileNameOf(String(d.lecture.notebook.student)) : null;
const repos: string[] = d.lecture.source_repos ?? [];
const basicsReady: string[] = (loadBasics() as any).readyIds;
---
<Base title={`${step.title_ko} · 단계 ${step.order}`} nav="lectures" back={`/lectures/${lid}/`} wide>
  <StepApp
    client:load
    lectureId={lid}
    lectureLabel={label}
    videoId={d.lecture.youtube_video_id}
    videoUrl={d.lecture.video_url}
    contentVersion={d.lecture.content_version}
    notebookName={nb}
    step={step}
    steps={steps}
    questions={questions}
    basicsReady={basicsReady}
  />
  {repos.length > 0 && <CodeCredit credit={codeCredit(repos)} />}
</Base>
