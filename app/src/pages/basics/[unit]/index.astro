---
// 사전 기초 단위 개요 /basics/F-P1/ (내용 있는 단위만 만든다. 정본 status planned 단위는 주소가 없다)
import Base from '../../../layouts/Base.astro';
import UnitApp from '../../../components/UnitApp.tsx';
import { loadBasics } from '../../../lib/content/basics.mjs';

export function getStaticPaths() {
  return loadBasics().readyIds.map((id) => ({ params: { unit: id }, props: { unitId: id } }));
}
const { unitId } = Astro.props as { unitId: string };
const b = loadBasics();
const u = b.units.find((x) => x.unit_id === unitId);
if (!u) throw new Error(`기초 단위 ${unitId}가 화면 데이터에 없습니다`);
const group = b.groups.find((g) => g.id === u.group);
const i = b.readyIds.indexOf(unitId);
const nextUnit = i >= 0 && i < b.readyIds.length - 1 ? b.units.find((x) => x.unit_id === b.readyIds[i + 1]) : null;
---
<Base title={`${u.unit_id} ${u.title_ko}`} nav="basics" back="/basics/">
  <UnitApp
    client:load
    lectureId={b.lecture_id}
    contentVersion={b.content_version}
    basicsReady={b.readyIds}
    unit={{
      unit_id: u.unit_id,
      title_ko: u.title_ko,
      group_label: group?.label_ko ?? '',
      goal_ko: u.goal_ko,
      analogy_ko: u.analogy_ko,
      card_ko: u.card_ko,
      extra_objectives: u.objectives.filter((o) => o !== u.goal_ko),
      needed_by_lectures: u.needed_by_lectures,
      estimated_minutes: u.estimated_minutes,
      mastery: u.mastery,
    }}
    rule={b.rule}
    steps={(b.steps[unitId] ?? []).map((s) => ({ step_id: s.step_id, slug: s.slug, order: s.order, title_ko: s.title_ko, meaning_ko: s.meaning_ko, kind: s.kind, question_ids: s.question_ids }))}
    rebuild={b.rebuild[unitId] ?? []}
    next={nextUnit ? { unit_id: nextUnit.unit_id, title_ko: nextUnit.title_ko } : null}
  />
</Base>
