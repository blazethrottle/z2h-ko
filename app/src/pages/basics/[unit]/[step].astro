---
// 사전 기초 단계 화면 /basics/F-P1/S02/ : 1편 단계 화면(StepApp)을 그대로 쓴다. 영상 없음(구간 칸 없이 따라 하기부터),
// 노트북 받기 대신 "새 셀에 붙여 넣고 실행" 한 줄, 확인 문제는 정본 after_step 단계 뒤(1편과 같음).
import Base from '../../../layouts/Base.astro';
import StepApp from '../../../components/StepApp.tsx';
import { loadBasics } from '../../../lib/content/basics.mjs';

export function getStaticPaths() {
  const b: any = loadBasics();
  return b.readyIds.flatMap((uid: string) => b.steps[uid].map((s: any) => ({ params: { unit: uid, step: s.slug }, props: { unitId: uid, stepId: s.step_id } })));
}
const { unitId, stepId } = Astro.props as { unitId: string; stepId: string };
const b: any = loadBasics();
const unitSteps: any[] = b.steps[unitId];
const step = unitSteps.find((s: any) => s.step_id === stepId);
const questions = step.question_ids.map((q: string) => b.questions[unitId].find((x: any) => x.question_id === q)).filter(Boolean);
const steps = unitSteps.map((s: any) => ({ step_id: s.step_id, slug: s.slug, order: s.order, title_ko: s.title_ko, video_segments: [] }));
---
<Base title={`${step.title_ko} · ${unitId} 단계 ${step.order}`} nav="basics" back={`/basics/${unitId}/`} wide>
  <StepApp
    client:load
    lectureId={b.lecture_id}
    lectureLabel={`기초 ${unitId}`}
    videoId={null}
    videoUrl={null}
    contentVersion={b.content_version}
    notebookName={null}
    step={step}
    steps={steps}
    questions={questions}
    basicsReady={b.readyIds}
    basePath={`/basics/${unitId}/`}
    overviewLabel={`단위 ${unitId}`}
    notebookGuide={false}
    trackResume={false}
    questionRetry={true}
  />
</Base>
