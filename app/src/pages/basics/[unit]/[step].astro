---
// 사전 기초 단계 화면 /basics/F-P1/S2b/ : 1편 단계 화면(StepApp)을 그대로 쓴다. 영상 없음(구간 칸 없이 따라 하기부터),
// 노트북 받기 대신 "새 셀에 붙여 넣고 실행" 한 줄, 확인 문제는 정본 after_step 단계 뒤(1편과 같음).
import Base from '../../../layouts/Base.astro';
import StepApp from '../../../components/StepApp.tsx';
import { loadBasics } from '../../../lib/content/basics.mjs';
import type { PublicQuestion } from '../../../components/QuestionCard';

export function getStaticPaths() {
  const b = loadBasics();
  return b.readyIds.flatMap((uid) => (b.steps[uid] ?? []).map((s) => ({ params: { unit: uid, step: s.slug }, props: { unitId: uid, stepId: s.step_id } })));
}
const { unitId, stepId } = Astro.props as { unitId: string; stepId: string };
const b = loadBasics();
const unitSteps = b.steps[unitId] ?? [];
const step = unitSteps.find((s) => s.step_id === stepId);
if (!step) throw new Error(`기초 단계 ${stepId}가 화면 데이터에 없습니다`);
const questions = step.question_ids.map((q) => (b.questions[unitId] ?? []).find((x) => x.question_id === q)).filter((x): x is PublicQuestion => !!x);
const steps = unitSteps.map((s) => ({ step_id: s.step_id, slug: s.slug, order: s.order, title_ko: s.title_ko, video_segments: [] }));
---
<Base title={`${step.title_ko} · ${unitId} 단계 ${step.order}`} nav="basics" back={`/basics/${unitId}/`} wide>
  <StepApp
    client:load
    lectureId={b.lecture_id}
    lectureLabel={`기초 ${unitId}`}
    videoId={null}
    videoUrl={null}
    contentVersion={b.content_version}
    notebookName={null}
    step={step}
    steps={steps}
    questions={questions}
    basicsReady={b.readyIds}
    basePath={`/basics/${unitId}/`}
    overviewLabel={`단위 ${unitId}`}
    notebookGuide={false}
    trackResume={false}
    questionRetry={true}
  />
</Base>
