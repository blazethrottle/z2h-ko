---
// 8 사전 기초 (뼈대): 1편 선행 단위 목록과 추천 표시. 단위 내용·진단은 뒤로(자료 대기). 01편을 잠그지 않는다.
import Base from '../../layouts/Base.astro';
import { loadSite } from '../../lib/pageData';
const site: any = loadSite();
const units: any[] = site.units ?? [];
const main: any = Object.values(site.details)[0];
const prereq = new Set<string>(main?.lecture.prereq_units ?? []);
---
<Base title="사전 기초" nav="basics">
  <div class="stack">
    <p class="kicker">강의 전에 권장</p>
    <h1 class="t1">사전 기초</h1>
    <p class="muted">코드를 쓰는 법이 아니라 읽는 법부터 익힙니다. 결과는 추천일 뿐이고, 강의 01은 언제든 열 수 있습니다.</p>
    <section class="card stack-sm" aria-label="진단">
      <h2 class="t3">시작 전 진단 5문제</h2>
      <span class="waiting">자료 대기</span>
    </section>
    <section class="card stack-sm" aria-labelledby="units-h">
      <h2 class="t3" id="units-h">01편에 필요한 단위</h2>
      {units.length === 0 ? (
        <p class="waiting">자료 대기</p>
      ) : (
        <ul class="list" data-testid="units">
          {units.map((u) => (
            <li class="lrow">
              <span class="no num" style="width:3.4em">{u.unit_id}</span>
              <span class="main">{u.title_ko}</span>
              <span class="side small">{prereq.has(u.unit_id) || u.required ? <span class="badge cur">추천</span> : <span class="st-todo">있으면 좋음</span>}</span>
            </li>
          ))}
        </ul>
      )}
      <p class="cap">단위 내용은 자료 대기입니다.</p>
    </section>
  </div>
</Base>
