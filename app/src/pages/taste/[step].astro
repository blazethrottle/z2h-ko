---
// 맛보기 단계 화면 /taste/S01/ ~ (주소는 step_id 뒷부분). 마지막 단계(정리와 다음 길)는 끝 화면.
// 영상 플레이어 없음(D53). 단계 수는 콘텐츠에서 센다.
import Base from '../../layouts/Base.astro';
import TasteStepApp from '../../components/TasteStepApp.tsx';
import TasteDoneApp from '../../components/TasteDoneApp.tsx';
import { loadTaster } from '../../lib/content/taster.mjs';
import { codeCredit, colabUrlOf, lectureLabel, loadSite } from '../../lib/pageData';
import { TASTER } from '../../content-config.mjs';
import CodeCredit from '../../components/CodeCredit.astro';

export function getStaticPaths() {
  const t: any = loadTaster();
  return t.steps.map((s: any) => ({ params: { step: s.slug }, props: { stepId: s.step_id } }));
}
const { stepId } = Astro.props as { stepId: string };
const t: any = loadTaster();
const step = t.steps.find((s: any) => s.step_id === stepId);
const last = t.steps[t.steps.length - 1];
const steps = t.steps.map((s: any) => ({ step_id: s.step_id, slug: s.slug, order: s.order, title_ko: s.title_ko, minutes: s.minutes }));
const questions = step.question_ids.map((q: string) => t.questions.find((x: any) => x.question_id === q)).filter(Boolean);
const site: any = loadSite();
const firstLecture = site.lectures.find((l: any) => l.available) ?? null;
const links = {
  diagnostic: '/basics/diagnostic/',
  basics: '/basics/',
  lecture: firstLecture ? `/lectures/${firstLecture.lecture_id}/` : '/home/',
  lectureLabel: firstLecture ? lectureLabel(firstLecture.lecture_id, firstLecture.title_ko) : '강의 01',
};
const isLast = step.step_id === last.step_id;
const credit = codeCredit(TASTER.sourceRepos);
---
<Base title={`${step.title_ko} · 맛보기 ${step.order}`} tabs={false} back="/taste/" wide>
  {isLast ? (
    <TasteDoneApp
      client:load
      step={step}
      steps={steps}
      requiredSteps={t.lecture.requires_steps}
      contentVersion={t.lecture.content_version}
      artifact={t.lecture.artifact}
      links={links}
      nameFilter={t.nameFilter}
    />
  ) : (
    <TasteStepApp
      client:load
      step={step}
      steps={steps}
      questions={questions}
      requiredSteps={t.lecture.requires_steps}
      contentVersion={t.lecture.content_version}
      notebook={{ file: t.lecture.notebook.file, url: t.lecture.notebook.url }}
      colabUrl={colabUrlOf(t.lecture.notebook.path, t.lecture.notebook.available)}
    />
  )}
  <CodeCredit credit={credit} />
</Base>
